---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Complexity Clarified | Leadership, Technology & Organisational Change</title>
    <meta name="description" content="Exploring leadership, organisational change, decision making and technology through thoughtful essays and practical experience." />
</head>

<body class="d-flex flex-column min-vh-100">

    <Navigation />

    <main class="flex-grow-1">
        <slot />
    </main>

    <Footer />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
	<script is:inline src="/scripts/scripts.js"></script>
</body>
</html>