{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cc-semantic-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "ai": {
    "binding": "AI"
  },

  "ratelimits": [
    {
      "name": "ASK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],

  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "complexity-clarified-knowledge",
      "remote": true
    }
  ]
}
