---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";
import Subscribers from "../../components/Subscribers.astro";
import ArticleVideo from "../../components/ArticleVideo.astro";
import { getYouTubeId } from "../../utils/youtube";

export async function getStaticPaths() {
    const articles = await getCollection("articles");

    return articles.map((article) => ({
        params: {
            slug: article.id,
        },
        props: {
            article,
        },
    }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const pillarHero = {
    decisions: "/images/decisions-article.svg",
    leadership: "/images/leadership-article.svg",
    technology: "/images/technology-article.svg",
    change: "/images/change-article.svg",
};

const heroImage = pillarHero[article.data.pillar];

/* ==========================================================
   ARTICLE SHARING
========================================================== */

const articleUrl = new URL(Astro.url.pathname, Astro.site!).href;

const video = article.data.video;
const videoId = video ? getYouTubeId(video.url) : null;
const videoThumbnail = videoId
    ? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`
    : null;

const videoSchema = video && videoId
    ? {
        "@context": "https://schema.org",
        "@type": "VideoObject",
        name: article.data.title,
        description: article.data.description,
        thumbnailUrl: [videoThumbnail],
        uploadDate: article.data.date.toISOString(),
        embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}`,
    }
    : null;

const linkedInShareUrl =
    `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(articleUrl)}`;


/* ==========================================================
   ARTICLE META
========================================================== */

const publishedDate = article.data.date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
});

/*
 * Astro's glob loader retains the raw Markdown body by default.
 * The fallback protects us because `body` is typed as optional.
 */
const body = article.body ?? "";

/*
 * Remove common Markdown syntax before counting words.
 * This doesn't need to be linguistically perfect — we're producing
 * an estimated reading time.
 */
const plainText = body
    .replace(/^---[\s\S]*?---/, "")
    .replace(/```[\s\S]*?```/g, "")
    .replace(/`[^`]*`/g, "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/[#>*_~-]/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const wordCount = plainText
    ? plainText.split(" ").length
    : 0;

const readingTime = Math.max(
    1,
    Math.ceil(wordCount / 200)
);
---

<Layout
    title={article.data.title}
    description={article.data.description}
    type="article"
    publishedTime={article.data.date}
>

    {videoSchema && (
        <script
            type="application/ld+json"
            set:html={JSON.stringify(videoSchema)}
        />
    )}

    <!-- Article Hero -->
    <section
        class="article-hero"
        style={`--article-hero-image: url("${heroImage}")`}
    >

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-10">

                    <h1>
                        {article.data.title}
                    </h1>

                    <p class="lead text-body-secondary">
                        {article.data.description}
                    </p>

                    <div class="article-meta text-body-secondary">

                        <time datetime={article.data.date.toISOString()}>
                            {publishedDate}
                        </time>

                        <span aria-hidden="true">
                            ·
                        </span>

                        <span>
                            {readingTime} min read
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>

    {video && (
        <section class="article-video-section">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <ArticleVideo
                            video={video}
                            title={article.data.title}
                        />
                    </div>
                </div>
            </div>
        </section>
    )}


    <!-- Article Content -->
    <section class="article-content">

        <div class="container">

            <div class="row justify-content-center">

                <article class="article col-lg-10">

                    <Content />

                    <!-- Article Sharing -->
                    <div class="article-share">

                        <span class="article-share-label">
                            Share this article
                        </span>

                        <div class="article-share-actions">

                            <a
                                href={linkedInShareUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="article-share-link article-share-linkedin"
                                aria-label={`Share "${article.data.title}" on LinkedIn`}
                            >
                                <span class="article-share-icon-wrap">
                                    <img
                                        src="/images/linkedin-icon.svg"
                                        alt=""
                                        class="article-share-icon"
                                        aria-hidden="true"
                                    />
                                </span>

                                <span>LinkedIn</span>
                            </a>

                            <button
                                type="button"
                                class="article-share-link article-copy-link"
                                data-share-url={articleUrl}
                            >
                                <span
                                    class="material-symbols-rounded article-share-icon"
                                    aria-hidden="true"
                                >
                                    link
                                </span>
                                Copy link
                            </button>

                            <span
                                class="article-copy-confirmation"
                                aria-live="polite"
                            ></span>

                        </div>

                    </div>

                </article>

            </div>

        </div>

    </section>

    <!-- Newsletter subscription -->
    <section class="newsletter-section py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <Subscribers />
                </div>
            </div>
        </div>
    </section>

    <!-- Related Articles -->
    <section class="related-articles-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-10">

                    <RelatedArticles currentArticle={article} />

                </div>

            </div>

        </div>

    </section>

</Layout>


<!-- Article sharing behaviour -->
<script>
    document.querySelectorAll('.article-copy-link').forEach((button) => {

        button.addEventListener('click', async () => {

            const url = button.getAttribute('data-share-url');

            if (!url) return;

            try {

                await navigator.clipboard.writeText(url);

                const confirmation = button
                    .closest('.article-share-actions')
                    ?.querySelector('.article-copy-confirmation');

                if (confirmation) {

                    confirmation.textContent = 'Copied';

                    setTimeout(() => {
                        confirmation.textContent = '';
                    }, 2000);

                }

            } catch (error) {

                console.error('Unable to copy article link', error);

            }

        });

    });
</script>
