---
import { getYouTubeId } from "../utils/youtube";

interface Props {
    video: {
        mode: "supporting" | "primary";
        url: string;
        title: string;
        description: string;
        thumbnail: string;
        transcript?: string;
    };
}

const { video } = Astro.props;
const videoId = getYouTubeId(video.url);
---

<figure class="article-video">
    {videoId ? (
        <div
            class="video-facade ratio ratio-16x9 rounded-4 overflow-hidden"
            data-video-id={videoId}
        >
            <button
                type="button"
                class="video-play"
                aria-label={`Play ${video.title}`}
            >
                <img
                    src={video.thumbnail}
                    alt=""
                    class="w-100 h-100 object-fit-cover"
                    loading="lazy"
                    decoding="async"
                />
                <span class="video-play-button" aria-hidden="true">
                    ▶
                </span>
            </button>
        </div>
    ) : (
        <a href={video.url} target="_blank" rel="noopener noreferrer">
            Watch {video.title} on YouTube
        </a>
    )}

    <figcaption class="article-video-caption">
        <strong>{video.title}</strong>
        <p>{video.description}</p>
    </figcaption>
</figure>
