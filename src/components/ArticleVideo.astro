---
import { getYouTubeId } from "../utils/youtube";

interface Props {
    video: {
        url: string;
        transcript?: string;
    };
    title: string;
}

const { video, title } = Astro.props;

const videoId = getYouTubeId(video.url);

const thumbnail = videoId
    ? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`
    : null;
---

<figure class="article-video">
    {videoId ? (
        <div
            class="video-facade ratio ratio-16x9 rounded-4 overflow-hidden"
            data-video-id={videoId}
        >
            <button
                type="button"
                class="video-play"
                aria-label={`Play ${title}`}
            >
                <img
                    src={thumbnail!}
                    alt=""
                    class="w-100 h-100 object-fit-cover"
                    loading="lazy"
                    decoding="async"
                />
                <span class="video-play-button" aria-hidden="true">
                    ▶
                </span>
            </button>
        </div>
    ) : (
        <a href={video.url} target="_blank" rel="noopener noreferrer">
            Watch {title} on YouTube
        </a>
    )}
</figure>

{video.transcript && (
    <details class="article-video-transcript">
        <summary>Video transcript</summary>

        <div class="article-video-transcript-content">
            {video.transcript
                .trim()
                .split(/\n\s*\n/)
                .map((paragraph) => <p>{paragraph}</p>)}
        </div>
    </details>
)}
