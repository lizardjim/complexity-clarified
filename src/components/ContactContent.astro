<section>
	<div class="container py-5">
		<div class="row g-5">

			<div class="col-lg-5">
				<div class="pe-lg-5">

					<h3 class="mb-4">Start the conversation.</h3>

					<p class="mb-4 fs-5">
						Whether you're exploring digital transformation, leadership, organisational change or technology, or simply want to discuss an idea you've read on the site, I'd welcome the conversation.
					</p>

					<p class="mb-0 fs-5">
						The best decisions begin with better conversations.
					</p>

				</div>
			</div>

			<div class="col-lg-7">
				<h3 class="mb-4">Get in touch.</h3>

				<form action="" method="post">

					<div class="mb-3">
						<label for="name" class="form-label">Name</label>
						<input
							type="text"
							class="form-control"
							id="name"
							name="name"
						>
					</div>

					<div class="mb-3">
						<label for="email" class="form-label">Email Address</label>
						<input
							type="email"
							class="form-control"
							id="email"
							name="email"
						>
					</div>

					<div class="mb-4">
						<label for="message" class="form-label">Message</label>
						<textarea
							class="form-control"
							id="message"
							name="message"
							rows="5"
						></textarea>
					</div>

					<input
						type="submit"
						class="btn btn-primary rounded-4 w-50"
						value="Send Message"
					>

				</form>
			</div>

		</div>
	</div>
</section>